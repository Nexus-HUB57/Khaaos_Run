  "lighting_scenarios": [
    {
      "id": "day_neutral",
      "description": "Sol neutro para avaliar BaseColor, roughness e SSS sem direção artística enganosa.",
      "console_commands": ["r.Lumen.Reflections.Allow 1", "r.Lumen.ScreenProbeGather 1", "r.Shadow.Virtual.Enable 1", "r.Exposure.Offset 0"]
    },
    {
      "id": "golden_hour",
      "description": "Luz quente baixa para validar leitura de pele, tecido e anisotropia do cabelo.",
      "console_commands": ["r.Lumen.Reflections.Allow 1", "r.Lumen.ScreenProbeGather 1", "r.Shadow.Virtual.Enable 1", "r.Exposure.Offset -0.25"]
    },
    {
      "id": "night_interior",
      "description": "Interior noturno para detectar plástico, halos, emissive excessivo e perda de detalhe.",
      "console_commands": ["r.Lumen.Reflections.Allow 1", "r.Lumen.ScreenProbeGather 1", "r.Shadow.Virtual.Enable 1", "r.Exposure.Offset 0.75"]
    }
  ],
  "views": [
    {"id": "third_person_combat", "camera_tag": "CIGKV_Camera_ThirdPerson", "distance_m": 3.5},
    {"id": "first_person_ads", "camera_tag": "CIGKV_Camera_FirstPersonADS", "distance_m": 0.7}
  ],
  "expected_captures": 24,
  "acceptance": {
    "required_profiles": ["Low", "Medium", "High", "Ultra"],
    "required_lighting": ["day_neutral", "golden_hour", "night_interior"],
    "required_views": ["third_person_combat", "first_person_ads"],
    "minimum_png_width": 1920,
    "minimum_png_height": 1080,
    "medium_gpu_p95_ms_max": 16.67,
    "reject": ["plastic_skin", "hair_flat_highlight", "emissive_hiding_missing_detail", "vsm_acne", "lumen_flicker", "lod_pop", "weapon_clipping"]
