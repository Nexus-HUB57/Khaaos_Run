{
  "name": "khaaos-run",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "test:stress": "node --test test/stress.test.js",
    "test:infra": "node --test test/infrastructure.test.js",
    "server": "node server/server.js",
    "db:migrate": "node scripts/migrate.js",
    "test:real": "node --test test/real-adapters.test.js",
    "coverage": "c8 --all --include='server/**/*.js' --include='src/**/*.js' --exclude='test/**' --exclude='scripts/**' --reporter=text --reporter=lcov --reporter=json-summary --reports-dir=coverage npm test",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "redis": "^5.12.1",
    "three": "^0.169.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "vite": "^6.1.0"
  }
}
