# ══════════════════════════════════════════════════════════════
# Khaaos Run — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env with real secrets.
# ══════════════════════════════════════════════════════════════

# ─── General ────────────────────────────────────────────────────
NODE_ENV=production
KHAOS_REGION=sa1
KHAOS_VERSION=0.5.0

# ─── Database (PostgreSQL 16) ──────────────────────────────────
DATABASE_URL=postgresql://khaaos:password@localhost:5432/khaaos_run
DB_PASSWORD=changeme

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Opcional: Redis descartável para npm run test:ws-ticket-redis.
# WS_TICKET_REDIS_TEST_URL=redis://127.0.0.1:6379

# ─── Authentication ────────────────────────────────────────────
JWT_SECRET=changeme-min-32-chars-random-string
SESSION_SECRET=changeme-min-32-chars-random-string
PUBLIC_ORIGIN=https://game.example.com
# IDs OIDC autorizados a acessar o painel do Marechal; lista vazia mantém acesso fechado.
MARSHAL_CONSOLE_OPERATOR_IDS=

# ─── WebSocket ─────────────────────────────────────────────────
WS_TOKEN_SECRET=changeme-min-32-chars-random-string
# Somente dev/teste; produção sempre rejeita handshakes sem Origin.
WS_ALLOW_MISSING_ORIGIN=false
# Somente dev/teste em instância única; Redis é obrigatório para tickets WS em produção.
WS_LOCAL_TICKET_FALLBACK=false
WS_PORT=8080

# ─── EOS (Epic Online Services) ────────────────────────────────
# Obtained from Epic Developer Portal: https://dev.epicgames.com/portal
EOS_PRODUCT_ID=KHAOS_PRODUCT_ID
EOS_SANDBOX_ID=KHAOS_SANDBOX_ID
EOS_DEPLOYMENT_ID=KHAOS_DEPLOYMENT_ID
EOS_CLIENT_ID=KHAOS_CLIENT_ID
EOS_CLIENT_SECRET=KHAOS_CLIENT_SECRET
EOS_ENCRYPTION_KEY=KHAOS_ENCRYPTION_KEY
EOS_REGION=sa1

# ─── EAC (Easy Anti-Cheat) ─────────────────────────────────────
EAC_SDK_PATH=/opt/eac/sdk
EAC_SERVER_PORT=8577

# ─── Server Configuration ──────────────────────────────────────
MAX_PLAYERS=50
SERVER_NAME=Khaaos Run - CIGKV
MAP_NAME=KhaaosCIGKV
TICK_RATE=60
DEDICATED_SERVER=true

# ─── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_SECOND=10
DDOS_MAX_CONNECTIONS_PER_SECOND=50
DDOS_MAX_PER_IP=5

# ─── Discord Webhooks ──────────────────────────────────────────
DISCORD_WEBHOOK=https://discord.com/api/webhooks/CHANGME/CHANGME
DISCORD_WEBHOOK_SECURITY=https://discord.com/api/webhooks/CHANGME/CHANGME

# ─── Slack Webhooks ────────────────────────────────────────────
SLACK_WEBHOOK=https://hooks.slack.com/services/CHANGME/CHANGME/CHANGME

# ─── Grafana ───────────────────────────────────────────────────
GRAFANA_PASSWORD=changeme
GRAFANA_ADMIN_USER=admin

# ─── Prometheus ────────────────────────────────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d

# ─── CDN ───────────────────────────────────────────────────────
CDN_DOMAIN=cdn.khaaos.run
CLOUDFLARE_ZONE_ID=changeme
CLOUDFLARE_API_TOKEN=changeme

# ─── Render (Staging) ──────────────────────────────────────────
RENDER_API_KEY=changeme
RENDER_SERVICE_ID=changeme

# ─── Economy Bridge ────────────────────────────────────────────
ECONOMY_API_PORT=5000
ECONOMY_BRIDGE_HOST=localhost
KRC_SUPPLY_CAP=1000000000

# ─── Cloud Save ────────────────────────────────────────────────
CLOUD_SAVE_AUTO_SAVE_INTERVAL=120
CLOUD_SAVE_MAX_SIZE_KB=1024
CLOUD_SAVE_COMPRESSION=lz4
CLOUD_SAVE_MERGE_STRATEGY=ServerWins

# ─── Multi-Region (Fase 5) ─────────────────────────────────────
# Docker host for each region (used by deploy_multiregion.sh)
DOCKER_HOST_SA1=ssh://deploy@sa1.khaaos.run
DOCKER_HOST_NA1=ssh://deploy@na1.khaaos.run
DOCKER_HOST_EU1=ssh://deploy@eu1.khaaos.run
DATABASE_URL_SA1=postgresql://khaaos:password@db-sa1.internal:5432/khaaos_run
DATABASE_URL_NA1=postgresql://khaaos:password@db-na1.internal:5432/khaaos_run
DATABASE_URL_EU1=postgresql://khaaos:password@db-eu1.internal:5432/khaaos_run

# ─── Beta Campaign (Fase 5) ────────────────────────────────────
BETA_PHASE=Internal
NDA_REQUIRED=true
EXCO_TARGET=1000000
