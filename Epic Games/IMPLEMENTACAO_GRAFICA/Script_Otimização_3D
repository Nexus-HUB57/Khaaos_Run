3. Script A — malha do terreno por perfil

Arquivo: src/game3d/terrain-optimized.mjs. Gera índices, UVs, cores, normais e bounds; usa as funções originais por injeção. O material mantém repetição 34 e receiveShadow. Não há simplificação de colisão nem LOD dinâmico: o perfil é escolhido na construção do cenário.

A amostragem mais espaçada modifica interpolação, silhueta periférica, normais e cores entre vértices. Mesmo high requer aprovação visual. O custo de construção e a memória temporária não foram perfilados.

import * as THREE from 'three';

 

// Apenas geometria visual; nao modifica a simulacao.

export function buildOptimizedTerrain(scenario, {

  quality = 'high', heightAt, tintAt, materialFactory

} = {}) {

  for (const fn of [heightAt, tintAt, materialFactory]) {

    if (typeof fn !== 'function') throw new TypeError('Dependencia ausente');

  }

  const segments = { low: 24, medium: 48, high: 80 }[quality];

  if (!segments) throw new RangeError('Qualidade invalida');

  // Linhas explicitas impedem triangulos de atravessar a borda plana.

  const axis = [...new Set([

    ...Array.from({ length: segments + 1 },

      (_, i) => -220 + 440 * i / segments),

    -211, -198, -197, 197, 198, 211

  ])].sort((a, b) => a - b);

  const n = axis.length;

  const positions = [], colors = [], uvs = [], indices = [];

  for (const z of axis) for (const x of axis) {

    const h = heightAt(x, z, scenario.id);

    positions.push(x, h, z);

    colors.push(...tintAt(h, x, z, scenario.id));

    uvs.push((x + 220) / 440, (220 - z) / 440);

  }

  for (let j = 0; j < n - 1; j++) {

    for (let i = 0; i < n - 1; i++) {

      const a = j * n + i, b = a + 1, c = a + n, d = c + 1;

      indices.push(a, c, b, b, c, d);

    }

  }

  const geo = new THREE.BufferGeometry();

  geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));

  geo.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));

  geo.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));

  geo.setIndex(indices);

  geo.computeVertexNormals();

  geo.computeBoundingBox();

  geo.computeBoundingSphere();

  const material = materialFactory(34, scenario.groundTint);

  material.vertexColors = true;

  const mesh = new THREE.Mesh(geo, material);

  mesh.name = 'terrain';

  mesh.receiveShadow = true;

  mesh.userData.terrain = true;

  mesh.userData.optimizedTerrain = quality;

  return mesh;

}



