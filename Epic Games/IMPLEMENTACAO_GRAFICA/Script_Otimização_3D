5. Script C — auditoria e frametimes

Arquivo: src/game3d/scene-audit.mjs. O inventário percorre a cena inteira, inclusive objetos invisíveis, e deduplica recursos compartilhados por identidade. cpuBufferBytes soma ArrayBuffers alcançados: não mede VRAM, texturas comprimidas, render targets, bytes realmente usados de cada view ou custo de shader.

// Inventario de recursos na CPU; nao representa VRAM real.

export function auditScene(root, renderer = null) {

  const geometries = new Set(), materials = new Set(), textures = new Set();

  const buffers = new Set();

  let meshes = 0, instances = 0, geometryBytes = 0;

  function addAttribute(attribute) {

    const array = attribute?.isInterleavedBufferAttribute

      ? attribute.data.array : attribute?.array;

    if (array && !buffers.has(array.buffer)) {

      buffers.add(array.buffer);

      geometryBytes += array.buffer.byteLength;

    }

  }

  root.traverse(object => {

    if (!object.isMesh) return;

    meshes++;

    if (object.isInstancedMesh) {

      instances += object.count;

      addAttribute(object.instanceMatrix);

      addAttribute(object.instanceColor);

    }

    if (object.geometry) geometries.add(object.geometry);

    for (const mat of [object.material].flat()) {

      if (mat) materials.add(mat);

    }

  });

  for (const geo of geometries) {

    Object.values(geo.attributes).forEach(addAttribute);

    Object.values(geo.morphAttributes).flat().forEach(addAttribute);

    addAttribute(geo.index);

  }

  for (const mat of materials) {

    for (const value of Object.values(mat)) {

      if (value?.isTexture) textures.add(value);

    }

  }

  return {

    meshes, instances, geometries: geometries.size,

    materials: materials.size, directTextures: textures.size,

    cpuBufferBytes: geometryBytes,

    render: renderer ? { ...renderer.info.render } : null

  };

}

 

export function summarizeFrameTimes(samplesMs) {

  const values = samplesMs.filter(v => Number.isFinite(v) && v > 0)

    .sort((a, b) => a - b);

  if (!values.length) throw new RangeError('Sem amostras validas');

  const percentile = p => values[Math.ceil(values.length * p) - 1];

  return { samples: values.length, medianMs: percentile(0.5),

    p95Ms: percentile(0.95), p99Ms: percentile(0.99) };

}



