Coleta no loop existente de main3d.js

Adicione o import e, depois do bloco post.render/renderer.render, o trecho abaixo. Não crie outro requestAnimationFrame. O exemplo só coleta em desenvolvimento, ignora 120 intervalos de aquecimento e imprime uma janela de 600 amostras.

import { summarizeFrameTimes } from './scene-audit.mjs';

 

// Depois do render existente, dentro do metodo de frame:

if (import.meta.env.DEV) {

  const now = performance.now();

  const perf = this.scenarioPerf ??= {

    previous: now, warmup: 120, values: [], done: false

  };

  const elapsed = now - perf.previous;

  perf.previous = now;

  if (document.hidden || elapsed > 500) {

    perf.warmup = 120;

    perf.values = [];

  } else if (perf.warmup > 0) {

    perf.warmup--;

  } else if (!perf.done && elapsed > 0) {

    perf.values.push(elapsed);

    if (perf.values.length === 600) {

      console.table(summarizeFrameTimes(perf.values));

      perf.done = true;

    }

  }

}



Para uma nova coleta, execute this.scenarioPerf = undefined no ponto de controle de diagnóstico ou reinicie a sessão. Mantenha rota de câmera, cenário, seed, resolução e configuração comparáveis. A medição é intervalo entre frames, não tempo GPU; VSync e limitação do navegador afetam o resultado.

renderer.info.render normalmente reinicia em cada render. Com pós-FX multipass, a leitura pode representar apenas a última passagem. Para um experimento multipass, preserve info.autoReset, defina false, invoque info.reset() imediatamente antes do primeiro passe do frame, leia depois do último e restaure ao encerrar. Não misture protocolos A/B nem altere o controle adaptativo de perf3d.js para a versão de produção.



6. Suíte de regressão completa

Arquivo: test/scenario-optimization.test.mjs. O código abaixo já usa os imports de destino do projeto. A execução verificada foi isolada, com os mesmos módulos e funções reais de terrain3d.js/textures3d.js e somente a exportação de terrainTint na cópia de teste; o material canvas foi substituído por MeshStandardMaterial para permitir Node sem DOM.

import test from 'node:test';

import assert from 'node:assert/strict';

import * as THREE from 'three';

import { terrainHeightAt, terrainTint } from '../src/game3d/terrain3d.js';

import { buildOptimizedTerrain } from '../src/game3d/terrain-optimized.mjs';

import { createPropBatches, disposePropBatches } from '../src/game3d/prop-batches.mjs';

import { auditScene, summarizeFrameTimes } from '../src/game3d/scene-audit.mjs';

 

for (const id of ['CIGKV', 'Barburhen', 'Priadus', 'Ckesalth', 'Arukheea']) {

  for (const quality of ['low', 'medium', 'high']) {

    test(`terreno ${id}/${quality}`, () => {

      const mesh = buildOptimizedTerrain({ id, groundTint: '#ffffff' }, {

        quality, heightAt: terrainHeightAt, tintAt: terrainTint,

        materialFactory: () => new THREE.MeshStandardMaterial()

      });

      const g = mesh.geometry, p = g.attributes.position;

      const triangles = g.index.count / 3;

      assert.ok(triangles < 18432);

      for (let i = 0; i < p.count; i++) {

        const x = p.getX(i), z = p.getZ(i), y = p.getY(i);

        assert.ok(Number.isFinite(y));

        if (Math.max(Math.abs(x), Math.abs(z)) <= 197) assert.equal(y, 0);

        assert.ok(Math.abs(y - terrainHeightAt(x, z, id)) < 0.0001);

      }

      for (const a of Object.values(g.attributes)) {

        assert.ok(a.array.every(Number.isFinite));

      }

      // Amostra dentro de cada triangulo: nao basta testar vertices.

      for (let i = 0; i < g.index.count; i += 3) {

        const ids = [0, 1, 2].map(k => g.index.getX(i + k));

        const x = ids.reduce((s, k) => s + p.getX(k), 0) / 3;

        const z = ids.reduce((s, k) => s + p.getZ(k), 0) / 3;

        if (Math.max(Math.abs(x), Math.abs(z)) <= 197) {

          assert.ok(ids.every(k => p.getY(k) === 0));

        }

      }

      assert.ok(mesh.receiveShadow && mesh.userData.terrain);

      console.log(id, quality, triangles);

      g.dispose(); mesh.material.dispose();

    });

  }

}

 

test('instancias por celula, bounds e descarte', () => {

  const geometry = new THREE.BoxGeometry(1, 1, 1);

  const material = new THREE.MeshStandardMaterial();

  const matrices = [0, 5, 100].map(x => new THREE.Matrix4().makeTranslation(x, 0, 0));

  const group = createPropBatches({ geometry, material, matrices });

  assert.equal(group.children.length, 2);

  assert.equal(group.children.reduce((n, m) => n + m.count, 0), 3);

  assert.ok(group.children.every(m => m.boundingSphere.radius > 0));

  const audit = auditScene(group);

  assert.equal(audit.geometries, 1);

  assert.equal(audit.materials, 1);

  assert.equal(audit.instances, 3);

  assert.ok(audit.cpuBufferBytes > 0);

  let disposed = false;

  geometry.addEventListener('dispose', () => { disposed = true; });

  disposePropBatches(group);

  assert.equal(group.children.length, 0);

  assert.equal(disposed, false);

  geometry.dispose(); material.dispose();

});

 

test('rejeita transparencia, escala negativa e celula invalida', () => {

  const geometry = new THREE.BoxGeometry();

  const material = new THREE.MeshBasicMaterial({ transparent: true });

  assert.throws(() => createPropBatches({ geometry, material, matrices: [] }));

  material.transparent = false;

  assert.throws(() => createPropBatches({ geometry, material, matrices: [], cellSize: 0 }));

  assert.throws(() => createPropBatches({ geometry, material,

    matrices: [new THREE.Matrix4().makeScale(-1, 1, 1)] }));

  geometry.dispose(); material.dispose();

});

 

test('percentis e amostras invalidas', () => {

