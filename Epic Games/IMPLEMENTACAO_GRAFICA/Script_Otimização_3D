4. Script B — decoração instanciada por célula

Arquivo: src/game3d/prop-batches.mjs. Agrupa transformações de uma família homogênea em células XZ, permitindo frustum culling por batch. Use em uma família ainda não instanciada, ou refatore conscientemente um batch grande existente. Células menores podem aumentar draw calls em relação a uma única instância global.

Contrato obrigatório: mesmo BufferGeometry e mesmo material opaco; matrizes locais ao grupo; objetos estáticos; sem morphs, shader de vento, callbacks por objeto, cores individuais, picking por identidade ou sombras com configurações distintas. A API rejeita algumas entradas incompatíveis, mas não consegue detectar todas as dependências de gameplay.

import * as THREE from 'three';

 

// Construir no lugar de objetos individuais, nunca por cima deles.

// Contrato: decoracao estatica, opaca, sem interacao nem animacao.

// Matrizes em coordenadas LOCAIS do grupo retornado.

export function createPropBatches({

  geometry, material, matrices, cellSize = 64,

  castShadow = false, receiveShadow = true

}) {

  if (!geometry?.isBufferGeometry || !material?.isMaterial ||

      Array.isArray(material) || material.transparent ||

      material.opacity < 1 || material.transmission > 0 ||

      geometry.morphAttributes.position?.length) {

    throw new TypeError('Use geometria simples e material opaco unico');

  }

  if (!Number.isFinite(cellSize) || cellSize <= 0) {

    throw new RangeError('cellSize deve ser positivo');

  }

  const cells = new Map();

  for (const matrix of matrices) {

    if (!matrix?.isMatrix4 ||

        !matrix.elements.every(Number.isFinite) ||

        matrix.determinant() <= 0) {

      throw new TypeError('Matriz invalida, singular ou espelhada');

    }

    const e = matrix.elements;

    const key = `${Math.floor(e[12] / cellSize)},${Math.floor(e[14] / cellSize)}`;

    if (!cells.has(key)) cells.set(key, []);

    cells.get(key).push(matrix);

  }

  const group = new THREE.Group();

  group.name = 'static-prop-batches';

  for (const [key, list] of cells) {

    const batch = new THREE.InstancedMesh(geometry, material, list.length);

    batch.name = `props:${key}`;

    list.forEach((m, i) => batch.setMatrixAt(i, m));

    batch.instanceMatrix.needsUpdate = true;

    batch.castShadow = castShadow;

    batch.receiveShadow = receiveShadow;

    batch.computeBoundingBox();

    batch.computeBoundingSphere();

    batch.frustumCulled = true;

    group.add(batch);

  }

  return group;

}

 

// Nao libera geometry/material: podem pertencer a outros objetos.

export function disposePropBatches(group) {

  for (const child of [...group.children]) {

    if (!child.isInstancedMesh) continue;

    child.dispose();

    group.remove(child);

  }

  group.removeFromParent();

}



