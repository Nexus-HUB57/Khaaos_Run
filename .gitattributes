*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text

# ─── EAC SDK Binary ────────────────────────────────────────────
*.bin filter=lfs diff=lfs merge=lfs -text

# ─── LFS Locking (exclusive checkout) ──────────────────────────
# Uncomment when team grows beyond 1 dev:
# *.uasset lockable
# *.umap lockable
# *.blend lockable
# *.fbx lockable

# ─── Text/Code Files (no LFS) ──────────────────────────────────
*.h text eol=lf
*.cpp text eol=lf
*.cs text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.tf text eol=lf
*.tfvars text eol=lf

# ─── Secrets (never diff) ──────────────────────────────────────
.env diff=false
.env.* diff=false
*.pem diff=false
*.key diff=false
*.p12 diff=false
