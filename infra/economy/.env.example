# Khaaos Run — Economy API Environment Variables
# Copyright Nexus-HUB57

# PostgreSQL
POSTGRES_DB=khaaos_economy
POSTGRES_USER=khaaos
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgres://khaaos:changeme_in_production@localhost:5432/khaaos_economy

# Redis
REDIS_URL=redis://localhost:6379

# EOS SDK
EOS_CLIENT_ID=your_eos_client_id
EOS_CLIENT_SECRET=your_eos_client_secret
EOS_PRODUCT_ID=your_eos_product_id
EOS_SANDBOX_ID=your_eos_sandbox_id
EOS_DEPLOYMENT_ID=your_eos_deployment_id

# Economy
KRC_DECIMALS=2
LOAN_MAX_KRC=500
LOAN_INTEREST_PCT=10
BURN_RATE_PURCHASE=0.05
MATCH_REWARD_MIN=50
MATCH_REWARD_MAX=500

# Security
JWT_SECRET=changeme_in_production
CORS_ORIGIN=http://localhost:3000

# Monitoring
GRAFANA_PASSWORD=admin

# Server
PORT=3001
NODE_ENV=production
