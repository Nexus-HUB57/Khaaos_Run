# ══════════════════════════════════════════════════════════════
# Khaaos Run — Discord Bot Environment Variables
# Copy to .env and fill in real values. NEVER commit .env with real secrets.
# ══════════════════════════════════════════════════════════════

# ─── Discord Bot Credentials ──────────────────────────────────
# Create bot at https://discord.com/developers/applications
# Enable: SERVER MEMBERS INTENT, MESSAGE CONTENT INTENT
DISCORD_BOT_TOKEN=
# Application ID (= Client ID) from General Information page
DISCORD_APPLICATION_ID=
# Guild ID for the Khaaos Run server (https://discord.gg/GQCXA7YFu)
# Enable "Use Slash Commands" in Guild Settings → Integrations
DISCORD_GUILD_ID=
# Beta tester role ID (auto-assigned to linked EOS accounts)
DISCORD_BETA_ROLE_ID=

# ─── Discord OAuth2 (for Discord↔EOS account linking) ────────
# OAuth2 section in Developer Portal → General Information
DISCORD_OAUTH2_CLIENT_ID=
DISCORD_OAUTH2_CLIENT_SECRET=
DISCORD_OAUTH2_REDIRECT_URI=https://khaaos.run/api/discord/callback

# ─── Discord Webhooks (per EKhaaosWebhookChannel) ────────────
# Create webhooks in each target channel: Channel Settings → Integrations → Webhooks
# Format: https://discord.com/api/webhooks/{WEBHOOK_ID}/{WEBHOOK_TOKEN}
DISCORD_WEBHOOK_ANTI_CHEAT=
DISCORD_WEBHOOK_ECONOMY=
DISCORD_WEBHOOK_MATCH_RESULTS=
DISCORD_WEBHOOK_RANKED=
DISCORD_WEBHOOK_DEPLOY=
DISCORD_WEBHOOK_SERVER_STATUS=

# ─── Khaaos API Configuration ────────────────────────────────
# Base URL of the Economy API (internal Docker network or localhost)
KHAASOS_API_BASE=http://localhost:3001
# API key for authenticated endpoints (/api/v1/economy, /api/v1/discord-link)
KHAASOS_API_KEY=

# ─── Rich Presence Art Assets ────────────────────────────────
# Upload at: Developer Portal → Rich Presence → Art Assets
# 5 World images: world_cigkv, world_barburhen, world_priadus, world_ckesalth, world_arukheea
# 6 Species images: species_zheers, species_onith, species_skeetw, species_huran, species_venex, species_khael
# Each image: PNG, 512x512 minimum, max 512KB
# No env vars needed — these are uploaded to the portal and referenced by key name.

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
