# Khaaos Run — staging (copie para .env e ajuste)
# Segredos
ADMIN_TOKEN=troque-por-token-de-operacoes-forte
AUTH_SECRET=troque-por-segredo-de-assinatura-com-32bytes-min
KR_PG_PASSWORD=troque-senha-postgres-forte

# Gate de saturação do readiness (503 overload acima disso por réplica)
KR_READY_MAX_CONNECTIONS=2000

# Regionalização da réplica (autoscaling por região via /healthz regions[])
KR_REGION=sa-east

# Porta pública do nginx no host
KR_STAGING_PORT=8080

# Semente de partidas de staging
MATCH_SEED=CIGKV-staging

# ─── M4 — modo distribuído (2 réplicas reais + Redis) ───
# KR_DISTRIBUTED=1 liga ownership/fencing/convites na camada M3/M4.
# KR_REPLICA_URL é o endereço público desta implantação (redirect cross-réplica).
# Para o smoke cross-replica determinístico: bash deploy.sh --replicas 2
KR_DISTRIBUTED=1
KR_OWNERSHIP_TTL_MS=15000
KR_OWNERSHIP_HEARTBEAT_MS=5000
KR_REPLICA_URL=http://127.0.0.1:8080
KR_INVITE_TTL_MS=1800000

# Usuários de operação/smoke (passwordHash = scrypt:salt:hex32 do scrypt de 32B).
# ⚠️ ASPAS SIMPLES EXTERNAS OBRIGATÓRIAS: o deploy.sh faz `source .env` — sem
# as single quotes o bash consome as aspas duplas do JSON e o boot crasha.
# Gere com: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log('scrypt:'+s+':'+c.scryptSync('SUA_SENHA',s,32).toString('hex'))"
KR_USERS_JSON='[{"id":"u-smoke","username":"smoke","role":"player","region":"sa-east","passwordHash":"TROQUE"}]'

# Portas diretas das réplicas no modo 2 réplicas (app-a/app-b)
KR_APP_A_PORT=8081
KR_APP_B_PORT=8082

# ─── Autoscaler (autoscaler.mjs) ───
KR_AUTOSCALE_MIN=1
KR_AUTOSCALE_MAX=4
KR_AUTOSCALE_POLL_MS=5000
KR_AUTOSCALE_COOLDOWN_MS=60000
KR_AUTOSCALE_OUT_PCT=85
KR_AUTOSCALE_IN_PCT=30
# 1 = só registra a decisão (dry-run); 0 = executa docker compose --scale
KR_AUTOSCALE_DRYRUN=1
