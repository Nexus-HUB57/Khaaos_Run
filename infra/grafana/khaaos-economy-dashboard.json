{
  "annotations": {
    "list": []
  },
  "description": "KRC Economy + Two-Phase Commit (2PC). Fonte: /metrics do economy-api (Prometheus job khaaos-economy-api).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "title": "KRC in Circulation",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "khaaos_economy_krc_circulating",
          "legendFormat": "KRC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500000000
              },
              {
                "color": "red",
                "value": 900000000
              }
            ]
          }
        }
      }
    },
    {
      "title": "KRC Earned/s",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(khaaos_economy_krc_earned_total[5m])",
          "legendFormat": "Earned/s"
        }
      ]
    },
    {
      "title": "KRC Spent/s",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(khaaos_economy_krc_spent_total[5m])",
          "legendFormat": "Spent/s"
        }
      ]
    },
    {
      "title": "Tx/s",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(khaaos_economy_transactions_total[5m])",
          "legendFormat": "Tx/s"
        }
      ]
    },
    {
      "title": "KRC Flow (Earn vs Spend)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "rate(khaaos_economy_krc_earned_total[5m])",
          "legendFormat": "Earned/s"
        },
        {
          "expr": "rate(khaaos_economy_krc_spent_total[5m])",
          "legendFormat": "Spent/s"
        },
        {
          "expr": "rate(khaaos_economy_krc_earned_total[5m]) - rate(khaaos_economy_krc_spent_total[5m])",
          "legendFormat": "Net Flow/s"
        }
      ]
    },
    {
      "title": "Transaction Types",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (tx_type) (rate(khaaos_economy_transactions_total[5m]))",
          "legendFormat": "{{tx_type}}"
        }
      ]
    },
    {
      "title": "Ledger Hash Chain Integrity",
      "type": "stat",
      "gridPos-": "h4w6x0y12",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "khaaos_economy_ledger_integrity_check",
          "legendFormat": "Integrity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              }
            ]
          }
        }
      }
    },
    {
      "title": "Loan Book",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 12
      },
      "targets": [
        {
          "expr": "khaaos_economy_loans_active",
          "legendFormat": "Active Loans"
        },
        {
          "expr": "khaaos_economy_loans_defaulted_total",
          "legendFormat": "Defaults"
        },
        {
          "expr": "rate(khaaos_economy_loans_created_total[5m])",
          "legendFormat": "Created/s"
        }
      ]
    },
    {
      "title": "Economy Health Status",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "khaaos_economy_health_status",
          "legendFormat": "Status"
        }
      ]
    },
    {
      "title": "Supply Cap Utilization %",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 20
      },
      "targets": [
        {
          "expr": "(khaaos_economy_krc_circulating / 1000000000) * 100",
          "legendFormat": "Utilization"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      }
    },
    {
      "id": 1,
      "type": "row",
      "title": "Two-Phase Commit (2PC) — escrow → commit/abort",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": [],
      "datasource": null
    },
    {
      "id": 2,
      "type": "stat",
      "title": "2PC Prepares/s (5m)",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 29
      },
      "datasource": null,
      "targets": [
        {
          "expr": "sum(rate(khaaos_economy_2pc_requests_total{phase=\"prepare\",result=\"prepared\"}[5m]))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.2.0"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "2PC Commits/s (5m)",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 29
      },
      "datasource": null,
      "targets": [
        {
          "expr": "sum(rate(khaaos_economy_2pc_requests_total{phase=\"commit\",result=\"committed\"}[5m]))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "blue",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
