    {
      "id": 7,
      "type": "timeseries",
      "title": "2PC Taxa por Fase/Resultado (5m)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "datasource": null,
      "targets": [
        {
          "expr": "sum by (phase, result) (rate(khaaos_economy_2pc_requests_total[5m]))",
          "legendFormat": "{{phase}}/{{result}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "10.2.0"
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "2PC Latência p95 por Fase (5m)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "datasource": null,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(khaaos_economy_2pc_phase_duration_ms_bucket[5m])))",
          "legendFormat": "p95 {{phase}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "10.2.0"
    },
    {
      "title": "2PC Transactions by Phase",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "targets": [
        { "expr": "rate(khaaos_2pc_transactions_total{phase=\"prepare\"}[5m])", "legendFormat": "Prepare" },
        { "expr": "rate(khaaos_2pc_transactions_total{phase=\"commit\"}[5m])", "legendFormat": "Commit" },
        { "expr": "rate(khaaos_2pc_transactions_total{phase=\"abort\"}[5m])", "legendFormat": "Abort" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" },
        "overrides": []
      }
    },
    {
      "title": "2PC Transaction Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(khaaos_2pc_transaction_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(khaaos_2pc_transaction_duration_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(khaaos_2pc_transaction_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      }
    },
    {
      "title": "KRC Locked (2PC)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 38 },
      "targets": [
        { "expr": "khaaos_krc_locked_total", "legendFormat": "Locked KRC" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10000 }, { "color": "red", "value": 50000 }] } },
        "overrides": []
      }
    },
    {
      "title": "Insufficient Funds (2PC)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 38 },
      "targets": [
        { "expr": "rate(khaaos_2pc_insufficient_funds_total[5m])", "legendFormat": "Rejections/s" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.1 }] } },
        "overrides": []
      }
    },
    {
      "title": "HTTP Request Latency (Economy API)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(khaaos_http_request_duration_seconds_bucket{route=~\"/api/economy.*\"}[5m]))", "legendFormat": "p50 {{route}}" },
        { "expr": "histogram_quantile(0.95, rate(khaaos_http_request_duration_seconds_bucket{route=~\"/api/economy.*\"}[5m]))", "legendFormat": "p95 {{route}}" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "khaaos",
    "economy",
    "production"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "Khaaos Run — KRC Economy",
  "uid": "khaaos-economy",
  "version": 2
}
