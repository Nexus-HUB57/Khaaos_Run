    {
      "id": 6,
      "type": "stat",
      "title": "Escrow mais antigo (s)",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "datasource": null,
      "targets": [
        {
          "expr": "khaaos_economy_2pc_oldest_prepared_age_seconds",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
