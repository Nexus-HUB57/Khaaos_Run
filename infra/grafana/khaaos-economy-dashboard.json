      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 29
      },
      "datasource": null,
      "targets": [
        {
          "expr": "sum(rate(khaaos_economy_2pc_requests_total{phase=\"abort\",result=\"aborted\"}[5m])) + sum(rate(khaaos_economy_2pc_gc_recovered_total[5m]))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
